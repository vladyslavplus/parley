<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Parley.Notifications</RootNamespace>
    <AssemblyName>Parley.Notifications</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Notifications.Contracts\Notifications.Contracts.csproj" />
    <ProjectReference Include="..\..\Campaigns\Campaigns.Contracts\Campaigns.Contracts.csproj" />
    <ProjectReference Include="..\..\Crm\Crm.Contracts\Crm.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\Identity.Contracts\Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Insights\Insights.Contracts\Insights.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Parley.SharedKernel\Parley.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Fluid.Core" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Telegram.Bot" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <!-- Template folders hold one subfolder per template; the manifest names stay flat
         (Parley.Notifications.Templates.<file>) so the loader resolves them unchanged. -->
    <EmbeddedResource Include="Templates\**\*.txt" LogicalName="Parley.Notifications.Templates.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
