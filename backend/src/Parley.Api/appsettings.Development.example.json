{
  "Database": {
    "ConnectionString": "Host=<db_host>;Port=<db_port>;Database=<db_name>;Username=<db_user>;Password=<db_password>"
  },
  "Telemetry": {
    "OtlpEndpoint": "<otlp_endpoint>"
  },
  "Auth": {
    "SigningKey": "<auth_signing_key_at_least_32_bytes>",
    "PublicBaseUrl": "<public_base_url>"
  },
  "IdentityStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "CrmStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "Email": {
    "Host": "<smtp_host>",
    "Port": 0,
    "FromAddress": "<smtp_from_address>",
    "FromName": "Parley",
    "SecureSocketOption": "None",
    "Timeout": "00:00:30",
    "DefaultCulture": "en"
  },
  "TrustedProxies": {
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information"
      }
    }
  }
}
