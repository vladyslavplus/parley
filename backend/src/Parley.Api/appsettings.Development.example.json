{
  "Database": {
    "ConnectionString": "Host=<db_host>;Port=<db_port>;Database=<db_name>;Username=<db_user>;Password=<db_password>"
  },
  "Telemetry": {
    "OtlpEndpoint": "<otlp_endpoint>"
  },
  "Auth": {
    "SigningKey": "<auth_signing_key_at_least_32_bytes>",
    "PublicBaseUrl": "<public_base_url>"
  },
  "IdentityStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "CrmStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "CampaignsStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "InsightsStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "Insights": {
    "Priority": {
      "Weights": {
        "at_risk": 90,
        "needs_attention": 80,
        "promising": 70,
        "champions": 60,
        "loyal": 50,
        "regular": 40,
        "hibernating": 30,
        "lost": 20
      },
      "TaskDueBonus": 15,
      "StaleDealBonus": 10,
      "StaleDealDays": 14,
      "ItemsPerOwner": 100
    },
    "Dashboard": {
      "CacheSeconds": 45
    },
    "Jobs": {
      "QueueName": "default"
    }
  },
  "Campaigns": {
    "Send": {
      "MessageIdDomain": "<message_id_domain>",
      "UnsubscribeTokenKey": "<unsubscribe_token_key_at_least_32_characters>",
      "PublicApiBaseUrl": "<public_api_base_url>",
      "PublicWebBaseUrl": "<public_web_base_url>"
    }
  },
  "Email": {
    "Host": "<smtp_host>",
    "Port": 0,
    "FromAddress": "<smtp_from_address>",
    "FromName": "Parley",
    "SecureSocketOption": "None",
    "Username": "",
    "Password": "",
    "Timeout": "00:00:30",
    "DefaultCulture": "en"
  },
  "TrustedProxies": {
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information"
      }
    }
  }
}
