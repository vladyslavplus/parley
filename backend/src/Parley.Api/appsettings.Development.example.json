{
  "Database": {
    "ConnectionString": "Host=<db_host>;Port=<db_port>;Database=<db_name>;Username=<db_user>;Password=<db_password>"
  },
  "Telemetry": {
    "OtlpEndpoint": "<otlp_endpoint>"
  },
  "Auth": {
    "SigningKey": "<auth_signing_key_at_least_32_bytes>",
    "PublicBaseUrl": "<public_base_url>"
  },
  "Telegram": {
    "BotToken": "<telegram_bot_token>",
    "BotUsername": "<telegram_bot_username>",
    "WebhookSecret": "<telegram_webhook_secret>"
  },
  "IdentityStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "CrmStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "CampaignsStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "InsightsStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "NotificationsStorage": {
    "ApplyMigrationsOnStartup": true
  },
  "Notifications": {
    "DefaultPageSize": 20,
    "MaximumPageSize": 100
  },
  "Demo": {
    "Seed": {
      "Enabled": true,
      "RefreshAfterDays": 7,
      "AccountPassword": "test1234",
      "RandomSeed": 20261112
    }
  },
  "Insights": {
    "Priority": {
      "Weights": {
        "at_risk": 90,
        "needs_attention": 80,
        "promising": 70,
        "champions": 60,
        "loyal": 50,
        "regular": 40,
        "hibernating": 30,
        "lost": 20
      },
      "TaskDueBonus": 15,
      "StaleDealBonus": 10,
      "StaleDealDays": 14,
      "ItemsPerOwner": 100,
      "UpliftWeight": 0.7,
      "RfmWeight": 0.3,
      "UpliftHighThreshold": 0.1
    },
    "Dashboard": {
      "CacheSeconds": 45
    },
    "Jobs": {
      "QueueName": "default"
    },
    "Scoring": {
      "BaseUrl": "http://127.0.0.1:8090/",
      "ApiKey": "<ml_scoring_api_key>",
      "AttemptTimeoutSeconds": 10,
      "TotalTimeoutSeconds": 30,
      "BatchSize": 500,
      "MaximumRejectedShare": 0.05,
      "ClvHorizonDays": 365,
      "QueueName": "default"
    }
  },
  "Campaigns": {
    "Send": {
      "MessageIdDomain": "<message_id_domain>",
      "UnsubscribeTokenKey": "<unsubscribe_token_key_at_least_32_characters>",
      "PublicApiBaseUrl": "<public_api_base_url>",
      "PublicWebBaseUrl": "<public_web_base_url>"
    }
  },
  "Email": {
    "Host": "<smtp_host>",
    "Port": 0,
    "FromAddress": "<smtp_from_address>",
    "FromName": "Parley",
    "SecureSocketOption": "None",
    "Username": "",
    "Password": "",
    "Timeout": "00:00:30",
    "DefaultCulture": "en"
  },
  "TrustedProxies": {
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information"
      }
    }
  }
}
