{
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=<db_host>;Port=<db_port>;Database=<db_name>;Username=<db_user>;Password=<db_password>",
    "Retry": {
      "MaxAttempts": 3,
      "MaxRetryDelay": "00:00:00.5"
    }
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 5,
    "BaseBackoff": "00:00:05"
  },
  "Hangfire": {
    "WorkerCount": 4,
    "JobExpiration": "1.00:00:00",
    "JobExpirationCheckInterval": "01:00:00",
    "DeleteExpiredBatchSize": 1000,
    "RetryAttempts": 5,
    "QueuePollInterval": "00:00:05"
  },
  "Idempotency": {
    "KeyLifetime": "1.00:00:00",
    "CleanupSchemas": [ "crm", "campaigns" ],
    "MaxRequestBodyBytes": 1048576,
    "InProgressPollInterval": "00:00:00.05",
    "InProgressWaitTimeout": "00:00:05"
  },
  "Telemetry": {
    "OtlpEndpoint": "<otlp_endpoint>"
  },
  "Email": {
    "Host": "<smtp_host>",
    "Port": 0,
    "FromAddress": "<smtp_from_address>",
    "FromName": "Parley",
    "SecureSocketOption": "None",
    "Username": "",
    "Password": "",
    "Timeout": "00:00:30",
    "DefaultCulture": "en"
  },
  "Auth": {
    "Issuer": "parley-api",
    "Audience": "parley-app",
    "SigningKey": "<auth_signing_key>",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "RefreshReuseGraceSeconds": 30,
    "EmailConfirmationTokenLifetime": "1.00:00:00",
    "PasswordResetTokenLifetime": "01:00:00",
    "PasswordMinimumLength": 8,
    "MaxFailedAccessAttempts": 5,
    "LockoutDuration": "00:15:00",
    "PublicBaseUrl": "<public_base_url>",
    "ConfirmEmailPath": "/confirm-email",
    "ResetPasswordPath": "/reset-password",
    "EmailQueueName": "default"
  },
  "RateLimiting": {
    "Register": { "PermitLimit": 10, "Window": "01:00:00" },
    "Login": { "PermitLimit": 10, "Window": "00:01:00" },
    "Refresh": { "PermitLimit": 30, "Window": "00:01:00" },
    "ConfirmEmail": { "PermitLimit": 20, "Window": "01:00:00" },
    "ResendConfirmation": { "PermitLimit": 5, "Window": "01:00:00" },
    "ForgotPassword": { "PermitLimit": 5, "Window": "01:00:00" },
    "ResetPassword": { "PermitLimit": 10, "Window": "01:00:00" },
    "InvitationCreate": { "PermitLimit": 50, "Window": "01:00:00" },
    "InvitationAccept": { "PermitLimit": 20, "Window": "01:00:00" }
  },
  "TrustedProxies": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "IdentityStorage": {
    "ApplyMigrationsOnStartup": false
  },
  "CrmStorage": {
    "ApplyMigrationsOnStartup": false
  },
  "CampaignsStorage": {
    "ApplyMigrationsOnStartup": false
  },
  "InsightsStorage": {
    "ApplyMigrationsOnStartup": false
  },
  "Insights": {
    "Priority": {
      "Weights": {
        "at_risk": 90,
        "needs_attention": 80,
        "promising": 70,
        "champions": 60,
        "loyal": 50,
        "regular": 40,
        "hibernating": 30,
        "lost": 20
      },
      "TaskDueBonus": 15,
      "StaleDealBonus": 10,
      "StaleDealDays": 14,
      "ItemsPerOwner": 100
    },
    "Dashboard": {
      "CacheSeconds": 45
    },
    "Jobs": {
      "QueueName": "default"
    }
  },
  "Campaigns": {
    "Send": {
      "QueueName": "default",
      "BatchSize": 50,
      "MaxAttempts": 3,
      "RetryBackoff": "00:01:00",
      "RecoveryInterval": "00:05:00",
      "RatePerSecond": 10,
      "LeaseDuration": "00:05:00",
      "MessageIdDomain": "<message_id_domain>",
      "UnsubscribeTokenKey": "<unsubscribe_token_key>",
      "UnsubscribeTokenLifetime": "365.00:00:00",
      "PublicApiBaseUrl": "<public_api_base_url>",
      "PublicWebBaseUrl": "<public_web_base_url>",
      "UnsubscribePermitLimit": 30,
      "UnsubscribeWindow": "00:01:00"
    }
  },
  "CrmExports": {
    "Directory": "crm-exports",
    "QueueName": "default"
  },
  "Authorization": {
    "RolePermissionCacheLifetime": "00:05:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  }
}
