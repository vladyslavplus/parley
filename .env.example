# Copy to `.env` (`cp .env.example .env`) or let `scripts/demo-up.ps1` create it: the script generates every value that
# is still a `<placeholder>` in this file and never overwrites a real value.
# Docker Compose reads this file for variable interpolation; the API reads its settings from the environment that Compose
# passes to the containers. `.env` is git-ignored; no real secret is committed here.

# --- Database -------------------------------------------------------------------------------------------------------
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=<postgres_db>

# --- Scoring service (`--profile ml`) ---------------------------------------------------------------------------------
# Shared key of the scoring service. Compose interpolates it even when the `ml` profile is off, so set it always; use a
# long random value (for example `openssl rand -hex 32`). The API receives the same value as Insights__Scoring__ApiKey.
PARLEY_ML_KEY=<parley_ml_key>
# Address the API uses for scoring inside the compose network (default http://ml:8000/).
# ML_SCORING_BASE_URL=http://ml:8000/

# --- API settings -----------------------------------------------------------------------------------------------------
# Signing key of the access tokens, at least 32 bytes of random data. Required by the `app` profile; the API refuses to
# start without it. `scripts/demo-up.ps1` generates it when it is still a placeholder.
AUTH_SIGNING_KEY=<auth_signing_key_at_least_32_bytes>

# Addresses that appear in emails and unsubscribe links. They must match the published web and API ports below.
PUBLIC_WEB_BASE_URL=http://127.0.0.1:3000
PUBLIC_API_BASE_URL=http://127.0.0.1:5000

# Transactional email. Mailpit catches every message locally; nothing leaves the machine.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_FROM_ADDRESS=no-reply@parley.test

# Campaign sending: deterministic Message-ID domain and the HMAC key of the unsubscribe links (at least 32 characters).
# The API refuses to start without the key; `scripts/demo-up.ps1` generates it when it is still a placeholder.
CAMPAIGN_MESSAGE_ID_DOMAIN=parley.test
UNSUBSCRIBE_TOKEN_KEY=<unsubscribe_token_key_at_least_32_characters>

# Optional API setting: reverse proxies (the web BFF) whose X-Forwarded-For header is trusted for rate limiting. Empty:
# the socket address is the client. Without it every browser request reaches the API from the BFF address and all users
# share one rate-limit bucket. Has no effect unless the BFF runs with TRUSTED_INGRESS=true.
# TrustedProxies__KnownProxies__0=10.0.0.5
# TrustedProxies__KnownNetworks__0=10.0.0.0/8
# TRUSTED_INGRESS=false

# --- Web app ---------------------------------------------------------------------------------------------------------
# Absolute public origin of the web app: canonical URLs, hreflang and the Open Graph image URL. Include the scheme.
SITE_URL=http://127.0.0.1:3000

# --- Host ports (loopback only; shift them to run a second stack beside the first) --------------------------------------
API_PORT=5000
WEB_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
DB_PORT=5433
ML_PORT=8090
ASPIRE_UI_PORT=18888
ASPIRE_OTLP_PORT=4317

# --- Development demo seed (scripts/demo-up.ps1 sets these for its own Compose call; the plain `app` profile keeps the
# production-like defaults below and an empty password) -------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production
# DEMO_SEED_ENABLED=false
# DEMO_SEED_ACCOUNT_PASSWORD=<demo_seed_account_password>
# APPLY_MIGRATIONS_ON_STARTUP=false
