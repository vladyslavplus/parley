# Copy to `.env` (`cp .env.example .env`) and replace every placeholder.
# Docker Compose reads this file for variable interpolation; the API does not read it.
# Local development values (this machine): POSTGRES_USER=parley, POSTGRES_PASSWORD=parley,
# POSTGRES_DB=parley, VALKEY_PASSWORD=parley. Real secrets are never committed.
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=<postgres_db>
VALKEY_PASSWORD=<valkey_password>

# Shared key of the scoring service. Compose interpolates it even when the `ml` profile is off, so set it always;
# use a long random value (for example `openssl rand -hex 32`). The API needs the same value as
# Insights__Scoring__ApiKey when the service runs.
PARLEY_ML_KEY=<parley_ml_key>

# Optional API setting, read by the API process (not by Compose). Reverse proxies (the web BFF)
# whose X-Forwarded-For header is trusted for rate limiting. Empty: the socket address is the client.
# Without it every browser request reaches the API from the BFF address and all users share one
# rate-limit bucket: list the BFF address here and run the BFF with TRUSTED_INGRESS=true
# (see frontend/.env.example). Local development already trusts the loopback addresses.
# TrustedProxies__KnownProxies__0=10.0.0.5
# TrustedProxies__KnownNetworks__0=10.0.0.0/8
