# Base URL of the .NET API. Server-side use only (BFF).
API_BASE_URL=http://localhost:5000

# Set to true only when the BFF runs behind an ingress/reverse proxy that
# appends the real client address as the last X-Forwarded-For entry. The BFF
# then forwards that address to the API so rate limits apply per end user.
# The BFF's own address must also be listed in the API setting
# TrustedProxies (env form: TrustedProxies__KnownProxies__0=<address>),
# otherwise the API ignores the forwarded address.
TRUSTED_INGRESS=false
