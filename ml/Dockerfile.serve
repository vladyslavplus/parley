# Scoring service image: minimal CPU-only environment for the FastAPI service.
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    UV_NO_DEV=1 \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /uvx /bin/

WORKDIR /app

# Install dependencies first so this layer survives source-only changes.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --locked --group serve --no-install-project

COPY . /app

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --group serve

EXPOSE 8000

CMD ["python", "-c", "print('ML scoring service placeholder')"]
